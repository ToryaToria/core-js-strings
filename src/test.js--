/*   getFirstChar('John Doe') => 'J'
*   getFirstChar('cat') => 'c'
*   getFirstChar('') => ''
*/
function getFirstChar(value) {
  if (!value || value === null || value === undefined) {
    return '';
  }
  return value[0];
}

// console.log(getFirstChar('John Doe'));
// console.log(getFirstChar(''));
// console.log(getFirstChar(null));
// console.log(getFirstChar(undefined));
// console.log(getFirstChar());


/*   isString() => false
 *   isString(null) => false
 *   isString([]) => false
 *   isString({}) => false
 *   isString('test') => true
 *   isString(new String('test')) => true
 */
function isString(value) {
  let bool;
  if (
    !value ||
    value === null ||
    value === undefined ||
    typeof value === 'object'
  ) {
    bool = false;
  }
  if (typeof value === 'string') {
    bool = true;
  }
  return bool;
}

