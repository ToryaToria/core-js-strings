function invertCase(str) {
  const arrStr = str.split('');
  // console.log(arrStr);
  for (let i = 0; i < arrStr.length; i += 1) {
    const loverString = arrStr[i].toLowerCase();
  // console.log(loverString);
  // console.log(arrStr[i]);

    if (arrStr[i] === loverString) {
      arrStr[i] = arrStr[i].toUpperCase();
        // console.log(arrStr[i]);

    } else {
      arrStr[i] = arrStr[i].toLowerCase();
    }
  }

  return arrStr.join('');
}

console.log(invertCase('Hello, World!'));
console.log(  invertCase('JavaScript is Fun')  );
console.log(   invertCase('12345')  );
